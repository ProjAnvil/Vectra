# Local data dirs for stress tests/benchmarks (created on demand, deleted after use; results only land in docs/benchmarks/)
benchdata/
bin/
*.snap
*.tmp
node_modules/
dist/
__pycache__/
*.pyc
.DS_Store
*.test
.worktrees/

# Python SDK build artifacts (wheel/sdist output; `dist/` above covers sdk/python/dist/ and sdk/ts/dist/)
sdk/python/build/
*.egg-info/

# Go workspace: go.work is tracked; go.work.sum regenerates on local builds
go.work.sum
